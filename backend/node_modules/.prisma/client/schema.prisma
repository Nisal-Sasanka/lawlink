generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  name             String
  email            String         @unique
  password         String
  phone            String?
  city             String?
  role             Role           @default(USER)
  status           Status         @default(ACTIVE)
  avatar           String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  articles         Article[]
  clientProfile    ClientProfile?
  assignedCases    Complaint[]    @relation("LawyerAssignedCases")
  complaints       Complaint[]    @relation("ClientComplaints")
  lawyerProfile    LawyerProfile?
  receivedMessages Message[]      @relation("ReceivedMessages")
  sentMessages     Message[]      @relation("SentMessages")
  notifications    Notification[]
  packages         Package[]      @relation("LawyerPackages")
}

model ClientProfile {
  id                String   @id @default(uuid())
  userId            String   @unique
  state             String?
  pincode           String?
  dob               String?
  gender            String?
  preferredLanguage String?
  address           String?
  bio               String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LawyerProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  barCouncilId    String?  @unique
  specialization  String?
  experience      Int?
  location        String?
  state           String?
  languages       Json?
  education       String?
  bio             String?
  consultationFee Float?
  availability    String?
  linkedIn        String?
  website         String?
  isVerified      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Package {
  id          String      @id @default(uuid())
  name        String
  price       Float
  period      String
  description String?
  icon        String?
  badge       String?
  active      Boolean     @default(true)
  features    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  lawyerId    String?
  complaints  Complaint[]
  lawyer      User?       @relation("LawyerPackages", fields: [lawyerId], references: [id], onDelete: Cascade)

  @@index([lawyerId], map: "Package_lawyerId_fkey")
}

model Complaint {
  id                String          @id @default(uuid())
  title             String
  category          String
  priority          Priority        @default(LOW)
  description       String
  incidentDate      DateTime?
  location          String?
  opposingParty     String?
  status            ComplaintStatus @default(OPEN)
  clientId          String
  assignedToId      String?
  packageId         String?
  date              DateTime        @default(now())
  hearingDate       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  resolutionOutcome String?
  resolutionSummary String?
  assignedTo        User?           @relation("LawyerAssignedCases", fields: [assignedToId], references: [id])
  client            User            @relation("ClientComplaints", fields: [clientId], references: [id])
  package           Package?        @relation(fields: [packageId], references: [id])
  documents         Document[]

  @@index([assignedToId], map: "Complaint_assignedToId_fkey")
  @@index([clientId], map: "Complaint_clientId_fkey")
  @@index([packageId], map: "Complaint_packageId_fkey")
}

model Document {
  id          String    @id @default(uuid())
  complaintId String
  type        String
  url         String
  size        Int?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  complaint   Complaint @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId], map: "Document_complaintId_fkey")
}

model Article {
  id        String        @id @default(uuid())
  title     String
  category  String
  status    ArticleStatus @default(DRAFT)
  excerpt   String
  content   String?
  views     Int           @default(0)
  authorId  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  author    User          @relation(fields: [authorId], references: [id])

  @@index([authorId], map: "Article_authorId_fkey")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  read      Boolean  @default(false)
  type      String?
  createdAt DateTime @default(now())
  link      String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Notification_userId_fkey")
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  receiverId String
  text       String   @db.Text
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])

  @@index([receiverId], map: "Message_receiverId_fkey")
  @@index([senderId], map: "Message_senderId_fkey")
}

enum Role {
  USER
  LAWYER
  ADMIN
}

enum Status {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ComplaintStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
}

enum ArticleStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}
